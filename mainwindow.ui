        <property name="styleSheet">
         <string notr="true">/* ==== BUTTONS STYLE ==== */
QPushButton {
    background-color: #012a59;
    color: #ffffff;
    border: 2px solid #013366;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    transition: all 0.3s ease-in-out;
}

QPushButton:hover {
    background-color: #024b8a;
    border-color: #025aa5;
}

QPushButton:pressed {
    background-color: #013869;
    border-color: #011f3f;
}
</string>
        </property>
