/* En-têtes du tableau */
QHeaderView::section {
    background-color: rgb(13, 59, 102);    /* Fond des en-têtes */
    color: rgb(248, 249, 250);             /* Texte des en-têtes */
    font-weight: bold;                      /* Texte en gras */
    padding: 5px;                           /* Espacement intérieur */
    border: 1px solid #2980b9;             /* Bordure de l’en-tête */
}

/* Les cellules */
QTableWidget::item {
    background-color: rgb(255, 255, 255);  /* Fond blanc des cellules */
    color: rgb(0, 51, 102);                /* Texte bleu foncé */
    padding: 4px;                           /* Espacement intérieur */
    selection-background-color: rgb(41, 128, 185); /* Fond d’une cellule sélectionnée */
    selection-color: white;                 /* Texte de la cellule sélectionnée */
}

/* Lignes impaires et paires (optionnel pour effet zébré) */
QTableWidget::item:!selected:alternate {
    background-color: rgb(245, 245, 245);  /* Fond gris très clair pour les lignes alternées */
}
</string>
