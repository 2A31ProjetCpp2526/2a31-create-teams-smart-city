       <widget class="QLineEdit" name="lineEdit_45">
        <property name="geometry">
         <rect>
          <x>160</x>
          <y>110</y>
          <width>201</width>
          <height>21</height>
         </rect>
        </property>
        <property name="styleSheet">
         <string notr="true">QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #cfd9e6;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    color: #0a1a2f;
    selection-background-color: #c7e0ff;
    selection-color: #000000;
}

/* Focused (when user clicks or types) */
QLineEdit:focus {
    border: 2px solid #0078d7;          /* Modern blue accent */
    background-color: #ffffff;
    outline: none;
}

/* Hover effect */
QLineEdit:hover {
    border: 1.5px solid #9bbadf;
}

/* Disabled (grayed-out field) */
QLineEdit:disabled {
    background-color: #f0f3f6;
    color: #8c8c8c;
    border: 1px solid #d0d6df;
}

/* Placeholder text style */
QLineEdit::placeholder {
    color: #a0a9b8;
    font-style: italic;
}

/* Optional subtle shadow for depth */
QLineEdit {
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.1);
}</string>
        </property>
       </widget>
